<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="http://jsbsim.sourceforge.net/JSBSimScript.xsl"?>
<runscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://jsbsim.sf.net/JSBSimScript.xsd"
    name="C172 FINAL - Simulink DLQR Altitude Hold">

  <description>
    Final controlled co-simulation script for the C172 at 4000 ft / 185 ft/sec.
    Simulink owns throttle, mixture and elevator command.
    JSBSim owns the fixed longitudinal trim offset.
  </description>

  <use aircraft="c172p" initialize="c172p_cruise_init_stress"/>

  <run start="0.0" end="40" dt="0.0083333">

    <!-- No wind/gust disturbance during controller bring-up. -->
    <property value="0" persistent="true"> simulation/run_id </property>

    <event name="Set Temperature">
      <condition> simulation/sim-time-sec ge 0.0 </condition>
      <set name="atmosphere/delta-T">
        <function>
          <switch>
            <p> simulation/run_id </p>
            <v> 0.0 </v>
            <v> -36.0 </v>
            <v> 36.0 </v>
          </switch>
        </function>
      </set>
    </event>

    <event name="Initialize engine and pitch trim">
      <condition> simulation/sim-time-sec ge 0.01 </condition>

      <!-- This is the trim value found by JSBSim's own longitudinal trim:
           elevator-cmd-norm = 0
           pitch-trim-cmd-norm = 0.202122
           elevator-pos-rad ~= 0.0811215
      -->
      <set name="fcs/pitch-trim-cmd-norm" value="0.202122"/>

      <set name="propulsion/magneto_cmd" value="3"/>
      <set name="propulsion/starter_cmd" value="1"/>

      <notify>
        <property> simulation/sim-time-sec </property>
        <property> fcs/pitch-trim-cmd-norm </property>
      </notify>
    </event>

    <!--
      IMPORTANT:
      Do NOT set fcs/throttle-cmd-norm,
      fcs/mixture-cmd-norm, or fcs/elevator-cmd-norm here.
      Simulink writes those every timestep.
    -->

  </run>

  <!-- FlightGear visualization output.
       JSBSim remains the flight-dynamics source of truth.
       FlightGear only receives the aircraft state for 3D visualization. -->
  <output name="localhost"
          type="FLIGHTGEAR"
          port="5500"
          protocol="UDP"
          rate="60"/>
</runscript>
