# Simulink Coder / Embedded Coder build output — regenerated from the
# .slx files, shouldn't be versioned (generated_code/ holds the final,
# curated copy of what matters, not the raw build folder)
slprj/
*.slxc
*.autosave

# MATLAB autosave / editor state
*.asv
*.m~

# JSBSim SIL/PIL build artifacts (compiled binaries, not source)
*.obj
*.exe
*.lib
*.mk
*_ca.mk

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Editor/IDE
.vscode/
*.swp
